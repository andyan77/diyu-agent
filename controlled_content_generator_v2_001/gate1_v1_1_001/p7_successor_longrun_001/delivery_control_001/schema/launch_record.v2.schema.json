{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p7-launch-record-v2",
  "title": "里程碑启动记录 schema v2（spawn 前原子落盘；绑定启动时实际 HEAD）",
  "description": "v2 依发起人 2026-07-16 八项加固指令第 6 条重设计：启动记录必须在创建新会话之前以原子协议（同目录 tmp + fsync + rename）落盘，并绑定 git rev-parse HEAD 的实际值；会话结果（session_id/actual_model/exit_status）在 spawn 后写入独立的 LAUNCH_OUTCOME（launch_outcome.v1.schema.json，经 launch_record_digest 回绑本记录）。v1 封存（SUPERSESSION_LEDGER §7）。",
  "type": "object",
  "required": [
    "schema_version",
    "prompt_id",
    "milestone_id",
    "workspace",
    "input_commit",
    "launched_at_head",
    "rendered_prompt_path",
    "rendered_prompt_digest",
    "template_digest",
    "predecessor_receipt_digest",
    "handoff_digest",
    "write_surface_allowlist",
    "write_surface_denylist",
    "allowed_git_actions",
    "allowed_repo_and_remote_creation",
    "allowed_models_and_materials",
    "session_kind",
    "requested_model",
    "auto_memory_disabled",
    "auto_memory_disabled_before_spawn",
    "record_written_before_spawn",
    "write_protocol",
    "launched_by",
    "launched_at",
    "record_digest"
  ],
  "properties": {
    "schema_version": { "const": "p7-launch-record-v2" },
    "prompt_id": { "enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"] },
    "milestone_id": { "enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7"] },
    "workspace": { "type": "string", "minLength": 1 },
    "input_commit": {
      "description": "被启动里程碑的输入提交（= 前序 HANDOFF accepted_candidate_commit）",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "launched_at_head": {
      "description": "落盘时刻 git rev-parse HEAD 的实际值（指令第 6 条：绑定实际 HEAD；与仓库不符 = 记录无效）",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "rendered_prompt_path": { "type": "string", "minLength": 1 },
    "rendered_prompt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "template_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "predecessor_receipt_digest": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "const": "GENESIS_M1" }
      ]
    },
    "handoff_digest": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "const": "GENESIS_M1" }
      ]
    },
    "route_binding": { "enum": ["a", "b", null] },
    "write_surface_allowlist": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "write_surface_denylist": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "allowed_git_actions": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "allowed_repo_and_remote_creation": {
      "type": "array", "items": { "type": "string" }
    },
    "allowed_models_and_materials": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "session_kind": {
      "description": "对将要创建的会话的合同承诺：必须为全新顶层会话；实际结果在 LAUNCH_OUTCOME 复核，子代理伪装 = 启动无效",
      "const": "TOP_LEVEL_FRESH"
    },
    "requested_model": { "type": "string", "pattern": "fable" },
    "auto_memory_disabled": { "const": true },
    "auto_memory_disabled_before_spawn": {
      "description": "CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 在 spawn 之前已注入环境（指令第 7 条）",
      "const": true
    },
    "record_written_before_spawn": {
      "description": "本记录先于任何 spawn 动作落盘（指令第 6 条；LAUNCH_OUTCOME 回绑证实顺序）",
      "const": true
    },
    "write_protocol": { "const": "ATOMIC_WRITE_TMP_FSYNC_RENAME" },
    "launched_by": {
      "description": "只能是会话外监督器；作者会话/子代理启动 = 无效",
      "const": "SESSION_EXTERNAL_SUPERVISOR"
    },
    "launched_at": { "type": "string", "minLength": 1 },
    "previous_session_exited_evidence": { "type": "string" },
    "record_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
