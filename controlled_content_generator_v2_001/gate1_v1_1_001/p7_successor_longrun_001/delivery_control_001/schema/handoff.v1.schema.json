{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p7-handoff-v1",
  "title": "里程碑 HANDOFF schema（跨里程碑状态唯一载体的入口面）",
  "type": "object",
  "required": [
    "schema_version",
    "from_milestone",
    "to_milestone",
    "accepted_candidate_commit",
    "control_plane_commit",
    "active_contract_set_digest",
    "input_manifest_digest",
    "output_manifest_digest",
    "last_green_test_summary",
    "review_receipt_bindings",
    "next_entry_contract",
    "next_prompt_template_digest",
    "ready_set_result_digest",
    "issued_at",
    "handoff_digest"
  ],
  "properties": {
    "schema_version": { "const": "p7-handoff-v1" },
    "from_milestone": { "enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7"] },
    "to_milestone": {
      "type": "array",
      "items": { "enum": ["M2", "M3", "M4", "M5", "M6", "M7"] },
      "minItems": 1
    },
    "accepted_candidate_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "control_plane_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "active_contract_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output_manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "last_green_test_summary": { "type": "string", "minLength": 1 },
    "review_receipt_bindings": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["receipt_path", "receipt_digest", "reviewer_kind", "verdict"],
        "properties": {
          "receipt_path": { "type": "string" },
          "receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "reviewer_kind": { "type": "string" },
          "verdict": { "type": "string" }
        }
      }
    },
    "qualification_flags": { "type": "object" },
    "route_binding": { "enum": ["a", "b", null] },
    "next_entry_contract": { "type": "string", "minLength": 1 },
    "next_prompt_template_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ready_set_result_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issued_at": { "type": "string", "minLength": 1 },
    "handoff_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
