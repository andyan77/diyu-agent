{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p7-launch-outcome-v1",
  "title": "里程碑启动结果 schema（spawn 后落盘；经 launch_record_digest 回绑 spawn 前启动记录）",
  "description": "与 launch_record.v2 配对：记录只承载 spawn 前可知事实，结果只承载 spawn 后实际事实。结果文件缺失而记录存在 = 启动未完成或被拒；session_kind 非 TOP_LEVEL_FRESH = 子代理伪装 = 启动无效。",
  "type": "object",
  "required": [
    "schema_version",
    "milestone_id",
    "launch_record_digest",
    "launch_capability",
    "session_id",
    "session_kind",
    "actual_model",
    "exit_status",
    "auto_memory_disabled",
    "completed_at",
    "outcome_digest"
  ],
  "properties": {
    "schema_version": { "const": "p7-launch-outcome-v1" },
    "milestone_id": { "enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7"] },
    "launch_record_digest": {
      "description": "== 对应 LAUNCH_RECORD.v2.json 的 record_digest（回绑；不符 = 结果与记录脱钩 = 无效）",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "launch_capability": {
      "enum": [
        "AUTO_LAUNCHED",
        "AUTO_LAUNCH_CAPABILITY_UNAVAILABLE",
        "REFUSED_SUBAGENT_IMPERSONATION",
        "REFUSED_SESSION_REUSE"
      ]
    },
    "session_id": {
      "oneOf": [
        { "type": "string", "minLength": 8 },
        {
          "type": "object",
          "required": ["value", "unavailable_reason", "evidence_ref"],
          "properties": {
            "value": { "const": "UNAVAILABLE" },
            "unavailable_reason": { "type": "string", "minLength": 1 },
            "evidence_ref": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "session_kind": {
      "description": "实际会话种类；AUTO_LAUNCHED 时必须为 TOP_LEVEL_FRESH（其余能力值允许 NOT_APPLICABLE）",
      "enum": ["TOP_LEVEL_FRESH", "SUBAGENT", "NOT_APPLICABLE"]
    },
    "actual_model": { "type": "string", "minLength": 1 },
    "exit_status": { "type": ["integer", "string", "null"] },
    "auto_memory_disabled": { "const": true },
    "refusal_reason": { "type": "string" },
    "completed_at": { "type": "string", "minLength": 1 },
    "outcome_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "launch_capability": { "const": "AUTO_LAUNCHED" } } },
      "then": { "properties": { "session_kind": { "const": "TOP_LEVEL_FRESH" } } }
    }
  ]
}
