{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate1-third-p4-qualification-decision-v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "decision_authority",
    "coordinator_identity", "coordinator_session_logical_id",
    "coordinator_platform_agent_id", "review_metrics_digest",
    "qualification_score", "hard_veto", "qualification_verdict",
    "approved_first_output_request_ids", "decision_reason_codes", "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "gate1-third-p4-qualification-decision-v1.0"},
    "task_id": {"const": "GATE1_V11_P5_PREREQUISITE_P4_AUTHOR_OUTPUT_RECOVERY_001"},
    "decision_authority": {"const": "EXTERNAL_INDEPENDENT_QUALIFICATION_COORDINATOR"},
    "coordinator_identity": {"type": "string", "minLength": 1},
    "coordinator_session_logical_id": {"type": "string", "minLength": 1},
    "coordinator_platform_agent_id": {"type": "string", "minLength": 1},
    "review_metrics_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "hard_veto": {"type": "boolean"},
    "qualification_verdict": {"enum": ["APPROVE", "REJECT"]},
    "approved_first_output_request_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^P4T3-POS-CP[0-9]{2}$"}
    },
    "decision_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
