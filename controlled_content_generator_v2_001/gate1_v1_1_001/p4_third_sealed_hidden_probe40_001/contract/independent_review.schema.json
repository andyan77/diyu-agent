{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate1-third-p4-independent-review-v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "review_track", "review_scope", "reviewer_identity",
    "reviewer_session_logical_id", "reviewer_platform_agent_id", "blank_context",
    "other_review_unavailable", "packet_digest", "catalog_digest",
    "route_comparison_digest", "judgments", "route_gate", "overall_verdict",
    "review_digest"
  ],
  "properties": {
    "schema_version": {"const": "gate1-third-p4-independent-review-v1.0"},
    "task_id": {"const": "GATE1_V11_P5_PREREQUISITE_P4_AUTHOR_OUTPUT_RECOVERY_001"},
    "review_track": {"enum": ["CONTENT_VALUE", "FACT_AUTHORIZATION"]},
    "review_scope": {
      "enum": [
        "CONTENT_VALUE_USER_VALUE_PLATFORM_AND_PRODUCT_FIT",
        "FACT_AUTHORIZATION_CLAIM_AND_BOUNDARY"
      ]
    },
    "reviewer_identity": {"type": "string", "minLength": 1},
    "reviewer_session_logical_id": {"type": "string", "minLength": 1},
    "reviewer_platform_agent_id": {"type": "string", "minLength": 1},
    "blank_context": {"const": true},
    "other_review_unavailable": {"const": true},
    "packet_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route_comparison_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "judgments": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blind_item_id", "chosen_profile_id", "public_quality",
          "product_quality", "total_score", "grade", "first_acceptable",
          "hard_error_codes", "formulaic_or_near_duplicate",
          "related_blind_item_ids", "rationale"
        ],
        "properties": {
          "blind_item_id": {"type": "string", "pattern": "^P4T3-BLIND-[0-9]{2}-[0-9a-f]{12}$"},
          "chosen_profile_id": {"type": "string", "pattern": "^CP[0-9]{2}$"},
          "public_quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "truth_and_boundary", "apparel_specificity",
              "role_and_brand_consistency", "user_value",
              "platform_execution", "anti_formula"
            ],
            "properties": {
              "truth_and_boundary": {"type": "integer", "minimum": 0, "maximum": 20},
              "apparel_specificity": {"type": "integer", "minimum": 0, "maximum": 10},
              "role_and_brand_consistency": {"type": "integer", "minimum": 0, "maximum": 10},
              "user_value": {"type": "integer", "minimum": 0, "maximum": 10},
              "platform_execution": {"type": "integer", "minimum": 0, "maximum": 10},
              "anti_formula": {"type": "integer", "minimum": 0, "maximum": 10}
            }
          },
          "product_quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "product_core_fidelity", "product_specific_narrative_av", "continuity"
            ],
            "properties": {
              "product_core_fidelity": {"type": "integer", "minimum": 0, "maximum": 15},
              "product_specific_narrative_av": {"type": "integer", "minimum": 0, "maximum": 10},
              "continuity": {"type": "integer", "minimum": 0, "maximum": 5}
            }
          },
          "total_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "grade": {"enum": ["A", "B", "C", "D"]},
          "first_acceptable": {"type": "boolean"},
          "hard_error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "formulaic_or_near_duplicate": {"type": "boolean"},
          "related_blind_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "route_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_match_count", "reason_match_count", "audience_leak_count", "pass"],
      "properties": {
        "action_match_count": {"const": 20},
        "reason_match_count": {"const": 20},
        "audience_leak_count": {"const": 0},
        "pass": {"const": true}
      }
    },
    "overall_verdict": {"enum": ["PASS", "FAIL"]},
    "review_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"review_track": {"const": "CONTENT_VALUE"}}},
      "then": {"properties": {"review_scope": {"const": "CONTENT_VALUE_USER_VALUE_PLATFORM_AND_PRODUCT_FIT"}}}
    },
    {
      "if": {"properties": {"review_track": {"const": "FACT_AUTHORIZATION"}}},
      "then": {"properties": {"review_scope": {"const": "FACT_AUTHORIZATION_CLAIM_AND_BOUNDARY"}}}
    }
  ]
}
