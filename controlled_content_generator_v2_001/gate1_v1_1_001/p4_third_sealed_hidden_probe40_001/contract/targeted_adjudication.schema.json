{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate1-third-p4-targeted-adjudication-v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "adjudicator_identity",
    "adjudicator_session_logical_id", "adjudicator_platform_agent_id",
    "blank_context", "full_batch_rereviewed", "source_reports_preserved",
    "reviewed_blind_item_ids", "adjudications", "all_closed",
    "adjudication_digest"
  ],
  "properties": {
    "schema_version": {"const": "gate1-third-p4-targeted-adjudication-v1.0"},
    "task_id": {"const": "GATE1_V11_P5_PREREQUISITE_P4_AUTHOR_OUTPUT_RECOVERY_001"},
    "adjudicator_identity": {"type": "string", "minLength": 1},
    "adjudicator_session_logical_id": {"type": "string", "minLength": 1},
    "adjudicator_platform_agent_id": {"type": "string", "minLength": 1},
    "blank_context": {"const": true},
    "full_batch_rereviewed": {"const": false},
    "source_reports_preserved": {"const": true},
    "reviewed_blind_item_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^P4T3-BLIND-[0-9]{2}-[0-9a-f]{12}$"}
    },
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["blind_item_id", "closed", "rationale"],
        "properties": {
          "blind_item_id": {"type": "string", "pattern": "^P4T3-BLIND-[0-9]{2}-[0-9a-f]{12}$"},
          "closed": {"const": true},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "all_closed": {"const": true},
    "adjudication_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
