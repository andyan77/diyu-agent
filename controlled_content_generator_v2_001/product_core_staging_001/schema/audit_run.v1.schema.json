{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diyu.example/schema/eval-audit-spine/audit-run.v1.schema.json",
  "title": "Eval Audit Spine Audit Run Objects v1",
  "oneOf": [
    {
      "$ref": "#/$defs/attemptRecord"
    },
    {
      "$ref": "#/$defs/costEvent"
    },
    {
      "$ref": "#/$defs/runManifest"
    },
    {
      "$ref": "#/$defs/stageDecision"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringIdArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "attemptRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "run_id",
        "request_id",
        "mode",
        "attempt_index",
        "is_first_provider_response",
        "provider_call_id",
        "raw_response_digest",
        "retained_in_denominator",
        "eligible_for_first_acceptance",
        "object_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "eval-spine-attempt-record-v1"
        },
        "attempt_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "request_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mode": {
          "enum": [
            "DEVELOPMENT",
            "QUALIFICATION"
          ]
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 1
        },
        "is_first_provider_response": {
          "type": "boolean"
        },
        "provider_call_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "raw_response_digest": {
          "$ref": "#/$defs/digest"
        },
        "retained_in_denominator": {
          "type": "boolean"
        },
        "eligible_for_first_acceptance": {
          "type": "boolean"
        },
        "object_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "costEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "stage_id",
        "task_kind",
        "resource_kind",
        "budget_category",
        "outcome_status",
        "source_telemetry_event_digest",
        "object_id",
        "attempt_id",
        "provider",
        "model_revision",
        "provider_call_id",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "price_snapshot_id",
        "model_cost_usd",
        "reviewer_minutes",
        "reviewer_identity",
        "labor_rate_snapshot_id",
        "human_cost_usd",
        "wall_clock_seconds",
        "unavailable_reasons",
        "event_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "eval-spine-cost-event-v1"
        },
        "event_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stage_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "task_kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resource_kind": {
          "enum": ["MODEL_CALL", "HUMAN_REVIEW", "HYBRID"]
        },
        "budget_category": {
          "enum": [
            "one_time_gold_and_measurement_usd",
            "causal_pilot_60_usd",
            "open_120_usd",
            "hidden_40_usd",
            "baseline_240_plus_60_usd"
          ]
        },
        "outcome_status": {
          "enum": ["SUCCEEDED", "FAILED", "ABORTED"]
        },
        "source_telemetry_event_digest": {
          "$ref": "#/$defs/digest"
        },
        "object_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "price_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reviewer_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reviewer_identity": {
          "type": ["string", "null"]
        },
        "labor_rate_snapshot_id": {
          "type": ["string", "null"]
        },
        "human_cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "wall_clock_seconds": {
          "type": "number",
          "minimum": 0
        },
        "unavailable_reasons": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "attempt_id",
              "provider",
              "model_revision",
              "provider_call_id",
              "input_tokens",
              "cached_input_tokens",
              "output_tokens",
              "price_snapshot_id",
              "model_cost_usd",
              "reviewer_minutes",
              "reviewer_identity",
              "labor_rate_snapshot_id",
              "human_cost_usd"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "event_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "runManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "stage_id",
        "mode",
        "input_manifest_digest",
        "assignment_manifest_digest",
        "attempt_manifest_digest",
        "output_manifest_digest",
        "evaluation_manifest_digest",
        "review_manifest_digest",
        "cost_manifest_digest",
        "first_attempt_count",
        "request_count",
        "retry_count",
        "qualification_feedback_before_first_response",
        "manifest_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "eval-spine-run-manifest-v1"
        },
        "run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stage_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mode": {
          "enum": [
            "DEVELOPMENT",
            "QUALIFICATION"
          ]
        },
        "input_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "assignment_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "attempt_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "output_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "evaluation_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "review_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "cost_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "first_attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "request_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "qualification_feedback_before_first_response": {
          "type": "boolean"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "stageDecision": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {
            "properties": {
              "evidence_manifest_digests": {"minItems": 1},
              "decided_by": {"$ref": "#/$defs/nonEmptyString"},
              "decision_digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      ],
      "required": [
        "schema_version",
        "decision_id",
        "stage_id",
        "status",
        "reason_codes",
        "evidence_manifest_digests",
        "next_allowed_stage",
        "claims_allowed",
        "claims_forbidden",
        "decided_by",
        "decision_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "eval-spine-stage-decision-v1"
        },
        "decision_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stage_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "STOPPED",
            "NOT_QUALIFIED",
            "NOT_AUTHORIZED"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/stringIdArray",
          "minItems": 1
        },
        "evidence_manifest_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "uniqueItems": true
        },
        "next_allowed_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "claims_allowed": {
          "$ref": "#/$defs/stringIdArray"
        },
        "claims_forbidden": {
          "$ref": "#/$defs/stringIdArray"
        },
        "decided_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_digest": {
          "$ref": "#/$defs/nullableDigest"
        }
      }
    }
  }
}
