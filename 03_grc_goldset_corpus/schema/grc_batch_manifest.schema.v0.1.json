{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "grc_batch_manifest.schema.v0.1.json",
  "title": "GRC formal batch manifest",
  "description": "Structural contract for normalized/formal_120/p0_0X/batch_manifest.yaml. Only universally-present keys are required.",
  "type": "object",
  "required": ["batch_manifest"],
  "properties": {
    "batch_manifest": {
      "type": "object",
      "required": ["batch_id", "batch_type", "selected_clusters"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "batch_type": {"type": "string", "minLength": 1},
        "selected_clusters": {"type": "array", "minItems": 1}
      }
    }
  }
}
