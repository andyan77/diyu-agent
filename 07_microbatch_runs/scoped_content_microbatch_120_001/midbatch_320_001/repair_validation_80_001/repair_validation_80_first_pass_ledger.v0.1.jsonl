{"accepted_body_digest": "aa4f882535c49e70ddb46a9b112c7cfcd95b4f2c8341d7d8993c13cc3285a237", "asset_id": "RV80-ASSET-057", "bounded_correction_used": false, "checkpoint_id": "RV80-CP-03", "failure_codes": [], "first_pass_body_digest": "aa4f882535c49e70ddb46a9b112c7cfcd95b4f2c8341d7d8993c13cc3285a237", "first_pass_body_text": "我正在把毛衣前面一小截掖进百褶裙腰，后面继续松着，再穿乐福鞋走两步看裙摆。实习生原本想请一位顾客一起入画，我说不用。方法可以拍，路过的人不用被拉进来。今天只演示掖与不掖的区别；真正穿到谁身上，还是让本人照镜子决定。", "kernel_id": "SCM120-CAND-085", "machine_status": "PASS", "max_prior_jaccard": 0.0, "nearest_prior_asset_id": null}
