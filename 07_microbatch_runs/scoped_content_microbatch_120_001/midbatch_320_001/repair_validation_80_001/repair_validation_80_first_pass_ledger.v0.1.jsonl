{"accepted_body_digest": "ef9e3ad494ce313915d55ab1597a1b8fd14063002e8d2a4ba84454d32707030f", "asset_id": "RV80-ASSET-059", "bounded_correction_used": false, "checkpoint_id": "RV80-CP-03", "failure_codes": [], "first_pass_body_digest": "ef9e3ad494ce313915d55ab1597a1b8fd14063002e8d2a4ba84454d32707030f", "first_pass_body_text": "我正拿着清单核对今天能上墙的服装。确认尺码与状态后，才给模特换上廓形西装和阔腿裤；完成以后再退后，看肩部与裤长是否在同一条视线上。检查、实施、复核，各有一个结束标志。先把前一步做完，后一步才有东西可接，也少一次半途返工。", "kernel_id": "SCM120-CAND-088", "machine_status": "PASS", "max_prior_jaccard": 0.0, "nearest_prior_asset_id": null}
